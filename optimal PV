def write_output(
    output_path: Path,
    model_path: Path,
    irradiation_path: Path,
    temperature_path: Path,
    year: int,
    model: ModuleType,
    site,
    settings: dict,
    best: dict,
    coarse: pd.DataFrame,
    fine: pd.DataFrame,
    all_results: pd.DataFrame,
    best_hourly: pd.DataFrame,
    fixed_design_analyses: list[dict] | None = None,
):
    summary_rows = [
        ("Objective", "Maximize annual specific production [kWh/kWp]"),
        ("Year", year),
        ("Site", getattr(site, "name", "Hornsund")),
        ("Latitude [deg]", getattr(site, "latitude_deg", np.nan)),
        ("Longitude [deg E]", getattr(site, "longitude_east_deg", np.nan)),
        ("Base PV script", str(model_path)),
        ("Irradiation file", str(irradiation_path)),
        ("Temperature file", str(temperature_path)),
        ("Best tilt [deg]", best["tilt_deg"]),
        ("Best azimuth [deg]", best["azimuth_deg"]),
        ("Best specific yield [kWh/kWp]", best["specific_yield_kWh_per_kWp"]),
        ("Best mean CF [-]", best["mean_capacity_factor"]),
        ("Best max CF [-]", best["max_capacity_factor"]),
        ("Best mean POA [W/m2]", best["mean_poa_Wm2"]),
        ("Tilt search range [deg]", f"{settings['tilt_min']} to {settings['tilt_max']}"),
        ("Azimuth search range [deg]", f"{settings['azimuth_min']} to {settings['azimuth_max']}"),
        ("Coarse tilt step [deg]", settings["coarse_tilt_step"]),
        ("Coarse azimuth step [deg]", settings["coarse_azimuth_step"]),
        ("Fine step [deg]", settings["fine_step"]),
        ("ALBEDO_MIN inherited from base model", float(model.ALBEDO_MIN)),
        ("ALBEDO_MAX inherited from base model", float(model.ALBEDO_MAX)),
        ("Derating factor inherited from base model", float(model.DERATING_FACTOR)),
        ("NOCT inherited from base model [degC]", float(model.NOCT)),
        ("Temperature coefficient inherited [1/degC]", float(model.TEMPERATURE_COEFFICIENT)),
        ("Direct input interpretation", str(model.DIRECT_INPUT_TYPE)),
        ("Hourly conversion", str(model.HOURLY_CONVERSION)),
        (
            "Albedo model",
            "2015 Hornsund/Fuglebekken snow-cover reference from selected base PV script",
        ),
    ]

    summary = pd.DataFrame(summary_rows, columns=["Parameter", "Value"])

    top20 = all_results.head(20).copy()

    # Excel does not support timezone-aware datetime values.
    # Keep best_hourly unchanged for plotting/calculations, but create an
    # Excel-safe copy in which UTC timestamps are timezone-naive.
    best_hourly_excel = best_hourly.copy()
    if "timestamp_utc" in best_hourly_excel.columns:
        timestamps_excel = pd.to_datetime(
            best_hourly_excel["timestamp_utc"],
            utc=True,
            errors="coerce",
        )
        best_hourly_excel["timestamp_utc"] = (
            timestamps_excel.dt.tz_convert("UTC").dt.tz_localize(None)
        )

    with pd.ExcelWriter(output_path, engine="openpyxl") as writer:
        summary.to_excel(writer, sheet_name="Summary", index=False)
        top20.to_excel(writer, sheet_name="Top 20", index=False)
        coarse.to_excel(writer, sheet_name="Coarse grid", index=False)
        fine.to_excel(writer, sheet_name="Fine grid", index=False)
        all_results.to_excel(writer, sheet_name="All evaluations", index=False)
        best_hourly_excel.to_excel(writer, sheet_name="Best hourly", index=False)

        if fixed_design_analyses:
            pd.DataFrame(fixed_design_analyses).to_excel(
                writer,
                sheet_name="Fixed design analyses",
                index=False,
            )

        for sheet_name in writer.book.sheetnames:
            ws = writer.book[sheet_name]
            ws.freeze_panes = "A2"
            for cell in ws[1]:
                cell.font = cell.font.copy(bold=True)
            for col in ws.columns:
                letter = col[0].column_letter
                max_len = min(
                    45,
                    max(len(str(cell.value)) if cell.value is not None else 0 for cell in col) + 2,
                )
                ws.column_dimensions[letter].width = max(12, max_len)


def plot_coarse_heatmap(coarse: pd.DataFrame, best: dict):
    pivot = coarse.pivot_table(
        index="tilt_deg",
        columns="azimuth_deg",
        values="specific_yield_kWh_per_kWp",
        aggfunc="max",
    )

    fig, ax = plt.subplots(figsize=(11, 7))
    image = ax.imshow(
        pivot.to_numpy(),
        origin="lower",
        aspect="auto",
        extent=[
            float(pivot.columns.min()),
            float(pivot.columns.max()),
            float(pivot.index.min()),
            float(pivot.index.max()),
        ],
    )
    fig.colorbar(image, ax=ax, label="Specific yield [kWh/kWp]")
    ax.scatter([best["azimuth_deg"]], [best["tilt_deg"]], marker="x", s=90)
    ax.set_xlabel("Surface azimuth [deg] (0 = South, -East, +West)")
    ax.set_ylabel("Surface tilt [deg]")
    ax.set_title("Hornsund PV orientation optimization - coarse search")
    fig.tight_layout()
    plt.show()


def plot_best_cf(best_hourly: pd.DataFrame, best: dict):
    fig, ax = plt.subplots(figsize=(13, 5))
    ax.plot(
        best_hourly["timestamp_utc"],
        best_hourly["capacity_factor_kW_per_kWp"],
        linewidth=0.8,
    )
    ax.set_xlabel("Time")
    ax.set_ylabel("Capacity factor [kW/kWp]")
    ax.set_title(
        f"Best fixed orientation: tilt={best['tilt_deg']:.2f}°, "
        f"azimuth={best['azimuth_deg']:.2f}°"
    )
    ax.set_ylim(bottom=0.0)
    ax.grid(True, linewidth=0.6)
    fig.tight_layout()
    plt.show()


# -----------------------------------------------------------------------------
# MAIN
# -----------------------------------------------------------------------------
def main(show_plots: bool = True):
    print("=" * 78)
    print("HORNSUND PV DESIGN OPTIMIZATION")
    print("=" * 78)

    print("1. Select the existing Hornsund PV capacity-factor script...")
    model_path = choose_python_model_file()
    model = import_pv_model(model_path)

    print("2. Select the irradiation CSV...")
    irradiation_path = choose_irradiation_file()
    site, source_3h = model.read_hornsund_csv(irradiation_path)

    print("3. Select the SEKLIMA temperature CSV...")
    temperature_path = choose_temperature_file()
    temperature_data = model.read_temperature_csv(temperature_path)

    solar_years = sorted(source_3h["timestamp"].dt.year.dropna().astype(int).unique())
    temperature_years = sorted(
        temperature_data["timestamp_utc"].dt.year.dropna().astype(int).unique()
    )
    candidate_years = sorted(set(solar_years) & set(temperature_years))

    settings = ask_optimization_setup(candidate_years)
    year = int(settings["year"])

    print("\nMODEL PARAMETERS INHERITED FROM BASE SCRIPT")
    print("-------------------------------------------")
    print(f"ALBEDO_MIN = {model.ALBEDO_MIN}")
    print(f"ALBEDO_MAX = {model.ALBEDO_MAX}")
    print(f"DERATING_FACTOR = {model.DERATING_FACTOR}")
    print(f"NOCT = {model.NOCT} °C")
    print(f"TEMPERATURE_COEFFICIENT = {model.TEMPERATURE_COEFFICIENT} 1/°C")
    print(f"DIRECT_INPUT_TYPE = {model.DIRECT_INPUT_TYPE}")
    print(f"HOURLY_CONVERSION = {model.HOURLY_CONVERSION}")

    source_year = source_3h[source_3h["timestamp"].dt.year == year].copy()
    if source_year.empty:
        raise ValueError(f"No irradiation data found for {year}.")

    hourly = model.to_hourly(source_year)
    hourly, temperature_quality = model.attach_temperature(
        hourly, temperature_data, year
    )

    print("\nPRECOMPUTING YEAR-INDEPENDENT ORIENTATION TERMS...")
    data = prepare_hourly_model_data(model, site, hourly)

    best, coarse, fine, all_results = optimize_orientation(model, data, settings)
    best_metrics, best_hourly = evaluate_orientation(
        model,
        data,
        best["tilt_deg"],
        best["azimuth_deg"],
        return_hourly=True,
    )
    best.update(best_metrics)

    print("\nOPTIMUM FOUND")
    print("-------------")
    print(f"Tilt:             {best['tilt_deg']:.2f} deg")
    print(f"Azimuth:          {best['azimuth_deg']:.2f} deg")
    print(
        f"Specific yield:   {best['specific_yield_kWh_per_kWp']:.2f} kWh/kWp"
    )
    print(f"Mean CF:          {best['mean_capacity_factor']:.5f}")
    print(f"Maximum CF:       {best['max_capacity_factor']:.5f}")
    print(f"Mean POA:         {best['mean_poa_Wm2']:.2f} W/m2")

    if temperature_quality:
        print("\nTemperature data quality:")
        for key, value in temperature_quality.items():
            print(f"  {key}: {value}")

    # Optional repeated 1-D analyses:
    # - fix azimuth -> find the best tilt;
    # - fix tilt -> find the best azimuth.
    # After each result, the script asks again until the user selects NO.
    fixed_design_analyses = run_optional_fixed_design_loop(
        model=model,
        data=data,
        settings=settings,
    )

    output_path = choose_output_file(f"PV_design_optimization_Hornsund_{year}.xlsx")
    write_output(
        output_path=output_path,
        model_path=model_path,
        irradiation_path=irradiation_path,
        temperature_path=temperature_path,
        year=year,
        model=model,
        site=site,
        settings=settings,
        best=best,
        coarse=coarse,
        fine=fine,
        all_results=all_results,
        best_hourly=best_hourly,
        fixed_design_analyses=fixed_design_analyses,
    )

    print(f"\nCreated: {output_path}")

    if messagebox is not None:
        root = _make_root()
        messagebox.showinfo(
            "PV design optimization completed",
            (
                f"Best fixed orientation for {year}:\n\n"
                f"Tilt = {best['tilt_deg']:.2f}°\n"
                f"Azimuth = {best['azimuth_deg']:.2f}°\n"
                f"Specific yield = {best['specific_yield_kWh_per_kWp']:.1f} kWh/kWp\n"
                f"Mean CF = {best['mean_capacity_factor']:.4f}\n\n"
                f"Saved to:\n{output_path}"
            ),
            parent=root,
        )
        root.destroy()

    if show_plots:
        plot_coarse_heatmap(coarse, best)
        plot_best_cf(best_hourly, best)


if __name__ == "__main__":
    main()
