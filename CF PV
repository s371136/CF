    ALBEDO_MAX = float(settings["albedo_max"])
    DERATING_FACTOR = float(settings["derating_factor"])
    CLIP_AT_RATED_POWER = bool(settings["clip_at_rated_power"])
    DIRECT_INPUT_TYPE = str(settings["direct_input_type"])
    HOURLY_CONVERSION = str(settings["hourly_conversion"])
    DROP_FEB29 = bool(settings["drop_feb29"])
    MIN_SOLAR_ELEVATION_DEG = float(settings["min_solar_elevation"])
    NOCT = float(settings["noct"])
    TEMPERATURE_COEFFICIENT = float(settings["temperature_coefficient"])
    REFERENCE_CELL_TEMPERATURE = float(settings["reference_cell_temperature"])
    NOCT_REFERENCE_AMBIENT_TEMPERATURE = float(
        settings["noct_reference_ambient_temperature"]
    )
    NOCT_REFERENCE_IRRADIANCE = float(settings["noct_reference_irradiance"])
    TEMPERATURE_TIME_OFFSET_HOURS = float(
        settings["temperature_time_offset_hours"]
    )
    INTERPOLATE_MISSING_TEMPERATURE = bool(
        settings["interpolate_missing_temperature"]
    )




def read_temperature_csv(path: Path) -> pd.DataFrame:
    """Read the SEKLIMA file and convert Norwegian mean time to UTC."""
    print("Reading SEKLIMA air-temperature file...", flush=True)

    # The supplied SEKLIMA export uses semicolon separators.
    frame = pd.read_csv(
        path,
        sep=";",
        encoding="utf-8-sig",
        engine="python",
    )
    frame.columns = [str(column).strip() for column in frame.columns]

    time_col = next(
        (
            column
            for column in frame.columns
            if "time" in column.lower()
        ),
        None,
    )
    temp_col = next(
        (
            column
            for column in frame.columns
            if "air temperature" in column.lower()
            or column.lower().strip() in {"temperature", "temp", "tair"}
        ),
        None,
    )

    if time_col is None or temp_col is None:
        raise ValueError(
            "Temperature file must contain a time column and an "
            "'Air temperature' column. "
            f"Found columns: {list(frame.columns)}"
        )

    raw_time = frame[time_col].astype(str).str.strip()
    local_time = pd.to_datetime(
        raw_time,
        format="%d.%m.%Y %H:%M",
        errors="coerce",
    )

    missing_time = local_time.isna() & raw_time.ne("")
    if missing_time.any():
        local_time.loc[missing_time] = pd.to_datetime(
            raw_time.loc[missing_time],
            dayfirst=True,
            errors="coerce",
        )

    air_temperature = pd.to_numeric(
        frame[temp_col],
        errors="coerce",
    )

    data = pd.DataFrame(
        {
            "timestamp_local": local_time,
            "air_temperature_C": air_temperature,
        }
    ).dropna(subset=["timestamp_local"])

    # Norwegian mean time is UTC+1 by default.
    data["timestamp_utc"] = (
        data["timestamp_local"]
        - pd.to_timedelta(TEMPERATURE_TIME_OFFSET_HOURS, unit="h")
    )

    data["timestamp_utc"] = data["timestamp_utc"].dt.floor("h")

    data = (
        data.groupby("timestamp_utc", as_index=False)["air_temperature_C"]
        .mean()
        .sort_values("timestamp_utc")
        .reset_index(drop=True)
    )

    print(
        f"Temperature rows read: {len(data)} | "
        f"UTC range: {data['timestamp_utc'].min()} - "
        f"{data['timestamp_utc'].max()}",
        flush=True,
    )

    return data


def longest_missing_run(series: pd.Series) -> int:
    missing = series.isna().to_numpy()

    longest = 0
    current = 0

    for value in missing:
        if value:
            current += 1
            longest = max(longest, current)
        else:
            current = 0

    return int(longest)


def attach_temperature(
    hourly: pd.DataFrame,
    temperature_data: pd.DataFrame,
    year: int,
) -> tuple[pd.DataFrame, dict]:
    """Align SEKLIMA air temperature to the selected solar UTC timestamps."""
    result = hourly.copy()

    solar_index = pd.DatetimeIndex(result["timestamp"])

    # Solar timestamps are UTC-aware; SEKLIMA timestamps above are naive UTC.
    target_naive = solar_index.tz_convert("UTC").tz_localize(None)

    source = (
        temperature_data
        .set_index("timestamp_utc")["air_temperature_C"]
        .sort_index()
    )

    profile = source.reindex(target_naive)

    missing_before = int(profile.isna().sum())
    longest_gap = longest_missing_run(profile)

    print(
        f"Temperature {year}: {len(profile) - missing_before}/{len(profile)} "
        f"hours available; {missing_before} missing; "
        f"longest gap = {longest_gap} h.",
        flush=True,
    )

    if missing_before > 0:
        if not INTERPOLATE_MISSING_TEMPERATURE:
            raise ValueError(
                f"Temperature profile contains {missing_before} missing hours. "
                "Enable temperature interpolation in the settings window."
            )

        if longest_gap > 24:
            print(
                "WARNING: the temperature series contains a long missing gap "
                f"({longest_gap} h). Linear interpolation is being used because "
                "it was enabled in the settings. Treat this period with caution.",
                flush=True,
            )

        profile = profile.interpolate(
            method="time",
            limit_direction="both",
        )

    if profile.isna().any():
        raise ValueError(
            "Missing temperature values remain after interpolation."
        )

    result["air_temperature_C"] = profile.to_numpy(dtype=float)

    quality = {
        "temperature_missing_before_fill": missing_before,
        "temperature_longest_missing_gap_h": longest_gap,
        "temperature_interpolation_used": (
            missing_before > 0 and INTERPOLATE_MISSING_TEMPERATURE
        ),
    }

    return result, quality



def parse_site_metadata(first_line: str) -> Site:
    """Parse metadata such as: Hornsund 76.966666 N  15.716666 E."""
    pattern = re.compile(
        r"^\s*(.*?)\s+([0-9]+(?:\.[0-9]+)?)\s*([NS])\s+"
        r"([0-9]+(?:\.[0-9]+)?)\s*([EW])\s*$",
        re.IGNORECASE,
    )
    match = pattern.match(first_line.strip())
    if not match:
        raise ValueError(
            "Could not read site coordinates from the first CSV line. "
            f"Found: {first_line!r}"
        )

    name, lat_value, lat_dir, lon_value, lon_dir = match.groups()
    lat = float(lat_value) * (1.0 if lat_dir.upper() == "N" else -1.0)
    lon_east = float(lon_value) * (1.0 if lon_dir.upper() == "E" else -1.0)
    return Site(name=name.strip(), latitude_deg=lat, longitude_east_deg=lon_east)


def read_hornsund_csv(path: Path) -> tuple[Site, pd.DataFrame]:
    with path.open("r", encoding="utf-8-sig") as handle:
        first_line = handle.readline().strip()

    site = parse_site_metadata(first_line)

    # Second row contains the actual CSV header.
    frame = pd.read_csv(path, skiprows=1)
    frame.columns = [str(column).strip() for column in frame.columns]

    if frame.shape[1] < 4:
        raise ValueError("The irradiation file must contain Date, Global, Diffuse and Direct columns.")

    # Identify by meaning rather than by exact full source header.
    date_col = next((c for c in frame.columns if c.lower() == "date"), None)
    global_col = next((c for c in frame.columns if "global" in c.lower()), None)
    diffuse_col = next((c for c in frame.columns if "diffuse" in c.lower()), None)
    direct_col = next((c for c in frame.columns if "direct" in c.lower()), None)

    missing = [
        label
        for label, column in (
            ("Date", date_col),
            ("Global", global_col),
            ("Diffuse", diffuse_col),
            ("Direct", direct_col),
        )
        if column is None
    ]
    if missing:
        raise ValueError(f"Missing required columns: {missing}. Found: {list(frame.columns)}")

    data = pd.DataFrame(
        {
            "timestamp": pd.to_datetime(frame[date_col], utc=True, errors="coerce"),
            "ghi": pd.to_numeric(frame[global_col], errors="coerce"),
            "dhi": pd.to_numeric(frame[diffuse_col], errors="coerce"),
            "bhi": pd.to_numeric(frame[direct_col], errors="coerce"),
        }
    )
    data = data.dropna(subset=["timestamp"]).sort_values("timestamp").drop_duplicates("timestamp")

    for column in ("ghi", "dhi", "bhi"):
        data[column] = data[column].clip(lower=0.0)

    if data[["ghi", "dhi", "bhi"]].isna().any().any():
        bad = data[data[["ghi", "dhi", "bhi"]].isna().any(axis=1)]
        raise ValueError(f"Non-numeric irradiation values found in {len(bad)} rows.")

    # Strong consistency check for the horizontal interpretation.
    closure_error = data["ghi"] - data["dhi"] - data["bhi"]
    data["ghi_minus_dhi_minus_bhi"] = closure_error
    max_error = float(closure_error.abs().max()) if len(data) else float("nan")

    print("\nINPUT INTERPRETATION")
    print("--------------------")
    print(f"Site: {site.name}")
    print(f"Latitude:  {site.latitude_deg:.6f} deg")
    print(f"Longitude: {site.longitude_east_deg:.6f} deg East")
    print("Global  -> GHI (horizontal)")
    print("Diffuse -> DHI (horizontal)")
    print(f"Direct input currently treated as: {DIRECT_INPUT_TYPE}")
    print("Data check: source values satisfy GHI = DHI + Direct, which supports a BHI interpretation.")
    print(f"Max |GHI - DHI - BHI| in source data: {max_error:.6g} W/m2")

    return site, data


def to_hourly(data_3h: pd.DataFrame) -> pd.DataFrame:
    """Convert the source 3-hourly series to a 1-hour UTC series."""
    if HOURLY_CONVERSION not in {"linear", "repeat"}:
        raise ValueError('HOURLY_CONVERSION must be "linear" or "repeat".')

    data = data_3h.set_index("timestamp")[["ghi", "dhi", "bhi"]].copy()

    first = data.index.min()
    # Build complete calendar years so 2015 has 8760 h and leap-year 2016 has 8784 h.
    # The source ends at 21:00 on 31 Dec; for the final two hours of the last year
    # there is no following 00:00 point, so they are filled with the last available
    # value after interpolation. For the supplied Hornsund file these winter values
    # are zero, so this does not alter annual solar energy.
    last_year = int(data.index.max().year)
    last = pd.Timestamp(f"{last_year}-12-31 23:00:00", tz="UTC")
    first_year = int(data.index.min().year)
    first = pd.Timestamp(f"{first_year}-01-01 00:00:00", tz="UTC")
    hourly_index = pd.date_range(first, last, freq="1h", tz="UTC")

    if HOURLY_CONVERSION == "linear":
        hourly = data.reindex(data.index.union(hourly_index)).sort_index()
        hourly = hourly.interpolate(method="time").reindex(hourly_index).ffill().bfill()
    else:
        hourly = data.reindex(hourly_index, method="ffill")

    # The source identity should remain exact (up to floating point) after using
    # DHI and BHI as the independent quantities. Rebuild GHI accordingly.
    hourly["ghi"] = hourly["dhi"] + hourly["bhi"]
    hourly.index.name = "timestamp"
    hourly = hourly.reset_index()

    if DROP_FEB29:
        hourly = hourly[~((hourly["timestamp"].dt.month == 2) & (hourly["timestamp"].dt.day == 29))]

    return hourly.reset_index(drop=True)


def solar_geometry(timestamp_utc: pd.Timestamp, site: Site) -> SolarGeometry:
    """Solar position and incidence angle at a UTC timestamp.

    Conventions:
      latitude: North positive
      source longitude: East positive
      solar/surface azimuth: 0 South, negative East, positive West
      hour angle: negative morning, positive afternoon
    """
    if timestamp_utc.tzinfo is None:
        timestamp_utc = timestamp_utc.tz_localize("UTC")
    else:
        timestamp_utc = timestamp_utc.tz_convert("UTC")

    day = int(timestamp_utc.dayofyear)
    days_in_year = 366 if timestamp_utc.is_leap_year else 365
    decimal_time = (
        timestamp_utc.hour
        + timestamp_utc.minute / 60.0
        + timestamp_utc.second / 3600.0
    )

    fractional_year = 2.0 * math.pi / days_in_year * (
        day - 1 + (decimal_time - 12.0) / 24.0
    )

    equation_of_time = 229.18 * (
        0.000075
        + 0.001868 * math.cos(fractional_year)
        - 0.032077 * math.sin(fractional_year)
        - 0.014615 * math.cos(2.0 * fractional_year)
        - 0.040849 * math.sin(2.0 * fractional_year)
    )

    declination = (
        0.006918
        - 0.399912 * math.cos(fractional_year)
        + 0.070257 * math.sin(fractional_year)
        - 0.006758 * math.cos(2.0 * fractional_year)
        + 0.000907 * math.sin(2.0 * fractional_year)
        - 0.002697 * math.cos(3.0 * fractional_year)
        + 0.00148 * math.sin(3.0 * fractional_year)
    )

    # The original notes use longitudes positive West and negative East.
    local_longitude_west = -site.longitude_east_deg
    reference_meridian_west = 0.0  # UTC
    solar_culmination_time = (
        12.0
        + (local_longitude_west - reference_meridian_west) / 15.0
        - equation_of_time / 60.0
    )

    hour_angle = math.radians(15.0 * (decimal_time - solar_culmination_time))
    latitude = math.radians(site.latitude_deg)
    tilt = math.radians(SURFACE_TILT)
    surface_azimuth = math.radians(SURFACE_AZIMUTH)

    cos_zenith = (
        math.sin(latitude) * math.sin(declination)
        + math.cos(latitude) * math.cos(declination) * math.cos(hour_angle)
    )
    cos_zenith = clamp(cos_zenith, -1.0, 1.0)
    zenith = math.acos(cos_zenith)
    sin_zenith = max(0.0, math.sin(zenith))

    # Robust atan2 formulation, valid also during polar-day conditions.
    if sin_zenith < 1e-12:
        solar_azimuth = 0.0
    else:
        sin_azimuth = math.cos(declination) * math.sin(hour_angle) / sin_zenith
        denominator = sin_zenith * math.cos(latitude)
        if abs(denominator) < 1e-12:
            cos_azimuth = 1.0
        else:
            cos_azimuth = (
                cos_zenith * math.sin(latitude) - math.sin(declination)
            ) / denominator
        solar_azimuth = math.atan2(
            clamp(sin_azimuth, -1.0, 1.0),
            clamp(cos_azimuth, -1.0, 1.0),
        )

    cos_incidence = (
        math.cos(tilt) * cos_zenith
        + math.sin(tilt)
        * sin_zenith
        * math.cos(solar_azimuth - surface_azimuth)
    )
    cos_incidence = clamp(cos_incidence, -1.0, 1.0)

    return SolarGeometry(
        declination_deg=math.degrees(declination),
        hour_angle_deg=math.degrees(hour_angle),
        zenith_deg=math.degrees(zenith),
        elevation_deg=90.0 - math.degrees(zenith),
        azimuth_deg=math.degrees(solar_azimuth),
        cos_zenith=cos_zenith,
        cos_incidence=cos_incidence,
        incidence_deg=math.degrees(math.acos(cos_incidence)),
    )


def calculate_pv(hourly: pd.DataFrame, site: Site) -> pd.DataFrame:
    records: list[dict] = []
    tilt = math.radians(SURFACE_TILT)
    sky_view_factor = (1.0 + math.cos(tilt)) / 2.0
    ground_view_factor = (1.0 - math.cos(tilt)) / 2.0

    for row in hourly.itertuples(index=False):
        timestamp = row.timestamp
        geometry = solar_geometry(timestamp, site)

        ghi = float(row.ghi)
        dhi = float(row.dhi)
        bhi = float(row.bhi)

        # Transform the source Direct component onto the tilted PV plane.
        derived_dni = 0.0
        poa_direct = 0.0

        sun_high_enough = geometry.elevation_deg >= MIN_SOLAR_ELEVATION_DEG
        module_front_illuminated = geometry.cos_incidence > 0.0

        if DIRECT_INPUT_TYPE.upper() == "BHI":
            # Source Direct is horizontal: BHI = DNI*cos(theta_z).
            if sun_high_enough and geometry.cos_zenith > 0.0 and bhi > 0.0:
                derived_dni = bhi / geometry.cos_zenith
                if module_front_illuminated:
                    poa_direct = derived_dni * geometry.cos_incidence
        elif DIRECT_INPUT_TYPE.upper() == "DNI":
            # Alternative only if confirmed by the source documentation.
            derived_dni = bhi
            if geometry.zenith_deg < 90.0 and module_front_illuminated:
                poa_direct = derived_dni * geometry.cos_incidence
        else:
            raise ValueError('DIRECT_INPUT_TYPE must be "BHI" or "DNI".')

        poa_diffuse = dhi * sky_view_factor
        ground_albedo, snow_cover_fraction = ground_albedo_for_timestamp(timestamp)
        poa_reflected = ghi * ground_albedo * ground_view_factor
        poa_global = max(0.0, poa_direct + poa_diffuse + poa_reflected)

        if not hasattr(row, "air_temperature_C"):
            raise RuntimeError(
                "Hourly air temperature has not been attached to the solar data."
            )

        air_temperature = float(row.air_temperature_C)

        if USE_TEMPERATURE_CORRECTION:
            cell_temperature = (
                air_temperature
                + (
                    (NOCT - NOCT_REFERENCE_AMBIENT_TEMPERATURE)
                    / NOCT_REFERENCE_IRRADIANCE
                )
                * poa_global
            )

            temperature_factor = (
                1.0
                + TEMPERATURE_COEFFICIENT
                * (
                    cell_temperature
                    - REFERENCE_CELL_TEMPERATURE
                )
            )
            temperature_factor = max(0.0, temperature_factor)
        else:
            cell_temperature = air_temperature
            temperature_factor = 1.0

        capacity_factor = DERATING_FACTOR * poa_global / 1000.0 * temperature_factor
        capacity_factor = max(0.0, capacity_factor)
        if CLIP_AT_RATED_POWER:
            capacity_factor = min(1.0, capacity_factor)

        records.append(
            {
                "timestamp_utc": timestamp,
                "year": int(timestamp.year),
                "ghi_horizontal_Wm2": ghi,
                "dhi_horizontal_Wm2": dhi,
                "bhi_horizontal_Wm2": bhi,
                "derived_dni_Wm2": derived_dni,
                "solar_declination_deg": geometry.declination_deg,
                "hour_angle_deg": geometry.hour_angle_deg,
                "solar_zenith_deg": geometry.zenith_deg,
                "solar_elevation_deg": geometry.elevation_deg,
                "solar_azimuth_deg": geometry.azimuth_deg,
                "incidence_angle_deg": geometry.incidence_deg,
                "poa_direct_Wm2": poa_direct,
                "poa_diffuse_Wm2": poa_diffuse,
                "ground_albedo": ground_albedo,
                "snow_cover_fraction_2015_reference": snow_cover_fraction,
                "poa_ground_reflected_Wm2": poa_reflected,
                "poa_global_Wm2": poa_global,
                "air_temperature_C": air_temperature,
                "cell_temperature_C": cell_temperature,
                "temperature_factor": temperature_factor,
                "capacity_factor_kW_per_kWp": capacity_factor,
            }
        )

    return pd.DataFrame.from_records(records)


def style_header(cell, fill, white):
    cell.fill = PatternFill("solid", fgColor=fill)
    cell.font = Font(name="Arial", bold=True, color=white)
    cell.alignment = Alignment(horizontal="center", vertical="center", wrap_text=True)


def write_results(path: Path, results: pd.DataFrame, site: Site) -> None:
