    summary = workbook.active
    summary.title = "Summary"

    dark_blue = "1F4E78"
    light_green = "E2F0D9"
    white = "FFFFFF"

    summary.merge_cells("A1:F1")
    summary["A1"] = "Hornsund photovoltaic capacity factor"
    summary["A1"].fill = PatternFill("solid", fgColor=dark_blue)
    summary["A1"].font = Font(name="Arial", size=15, bold=True, color=white)
    summary["A1"].alignment = Alignment(horizontal="left")

    metadata = [
        ("Site", site.name),
        ("Latitude [deg]", site.latitude_deg),
        ("Longitude [deg E]", site.longitude_east_deg),
        ("Surface tilt [deg]", SURFACE_TILT),
