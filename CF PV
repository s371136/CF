        ("Albedo model", "rho(t) from 2015 Hornsund/Fuglebekken snow-cover reference"),
        ("2015 snow-cover points", "17 May 90%; 10 Jun 75%; 15 Jun 50%; 20 Jun 25%; 27 Jun 10%; 06 Jul <2%"),
        ("Interpolation", "Linear between observed 2015 SCE points"),
        ("Before 17 May", "SCE = 1.0 -> rho = rho_max"),
        ("From 06 July onward", "SCE = 0.0 -> rho = rho_min; autumn return not imposed"),
        ("Derating factor [-]", DERATING_FACTOR),
        ("Hourly conversion", HOURLY_CONVERSION),
        ("Direct input interpretation", DIRECT_INPUT_TYPE),
        ("Temperature correction", "ON - SEKLIMA hourly air temperature"),
        ("NOCT [°C]", NOCT),
