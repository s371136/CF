def clamp(value: float, minimum: float, maximum: float) -> float:
    return max(minimum, min(maximum, value))


def snow_cover_fraction_2015_reference(timestamp) -> float:
    """Return the 2015 Hornsund/Fuglebekken reference Snow Cover Extent fraction.

    The six published 2015 SCE points are linearly interpolated in time.
    Before 17 May the ground is treated as fully snow covered (SCE = 1).
    From 06 July onward it is treated as snow free (SCE = 0).

    No autumn snow-return profile is imposed because no equivalent observed
    autumn SCE series is included in the current model.
    """
    year = int(timestamp.year)

    anchors = [
        (
            pd.Timestamp(
                year=year,
                month=month,
                day=day,
                tz="UTC",
            ),
            float(sce),
        )
        for (month, day), sce in SNOW_COVER_2015_POINTS
    ]

    current = pd.Timestamp(timestamp)
    if current.tzinfo is None:
        current = current.tz_localize("UTC")
    else:
        current = current.tz_convert("UTC")

    first_time, _ = anchors[0]
    last_time, _ = anchors[-1]

    if current < first_time:
        return 1.0

    # The final observation is <2% snow cover; from that date onward the
    # model treats the surrounding ground as effectively snow free.
    if current >= last_time:
        return 0.0

    for (time_a, sce_a), (time_b, sce_b) in zip(anchors[:-1], anchors[1:]):
        if time_a <= current < time_b:
            total_seconds = (time_b - time_a).total_seconds()
            elapsed_seconds = (current - time_a).total_seconds()
            fraction = elapsed_seconds / total_seconds
            sce = sce_a + fraction * (sce_b - sce_a)
            return clamp(float(sce), 0.0, 1.0)

    return 0.0


def ground_albedo_for_timestamp(timestamp) -> tuple[float, float]:
    """Return (rho(t), SCE(t)) using min/max albedo and the 2015 snow-cover profile."""
    snow_fraction = snow_cover_fraction_2015_reference(timestamp)
    rho = ALBEDO_MIN + snow_fraction * (ALBEDO_MAX - ALBEDO_MIN)
    return float(rho), float(snow_fraction)


def choose_input_file() -> Path:
    if tk is None:
        raise RuntimeError("Tkinter is not available. Set the input path directly in main().")
    root = tk.Tk()
    root.withdraw()
    root.attributes("-topmost", True)
    selected = filedialog.askopenfilename(
        title="Select Hornsund irradiation CSV",
        filetypes=[("CSV files", "*.csv"), ("All files", "*.*")],
    )
    root.destroy()
    if not selected:
        raise SystemExit("No input file selected.")
    return Path(selected)



def choose_temperature_file() -> Path:
