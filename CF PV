        for cell in sheet[1]:
            style_header(cell, dark_blue, white)
        sheet.freeze_panes = "A2"

        for values in subset.itertuples(index=False, name=None):
            values = list(values)
            ts = values[0]
            if isinstance(ts, pd.Timestamp):
                # Excel cannot store timezone-aware datetimes.
                values[0] = ts.tz_convert("UTC").tz_localize(None).to_pydatetime()
            sheet.append(values)

        last_col = sheet.cell(1, len(output_columns)).column_letter
        sheet.auto_filter.ref = f"A1:{last_col}{sheet.max_row}"
        sheet.column_dimensions["A"].width = 20
