def choose_output_file(default_name: str) -> Path:
    if tk is None:
        return Path(default_name)
    root = tk.Tk()
    root.withdraw()
    root.attributes("-topmost", True)
    selected = filedialog.asksaveasfilename(
        title="Save PV capacity-factor results",
        defaultextension=".xlsx",
        initialfile=default_name,
        filetypes=[("Excel workbook", "*.xlsx")],
    )
    root.destroy()
    if not selected:
        raise SystemExit("No output file selected.")
    return Path(selected)



def ask_analysis_setup(
    candidate_years: list[int],
    year_counts: dict[int, int],
) -> tuple[int, dict]:
    """Choose one year and the editable PV-model parameters."""
    if tk is None:
        raise RuntimeError("Tkinter is not available.")

    if not candidate_years:
        raise ValueError("No analysable years were found in the input file.")

    from tkinter import ttk

    default_year = 2015 if 2015 in candidate_years else candidate_years[0]

    result = {
        "year": None,
        "settings": None,
    }

    dialog = tk.Tk()
    dialog.title("Hornsund PV capacity factor - analysis settings")
    dialog.resizable(False, False)

    try:
        dialog.attributes("-topmost", True)
    except Exception:
        pass

    outer = ttk.Frame(dialog, padding=16)
    outer.grid(row=0, column=0, sticky="nsew")

    ttk.Label(
        outer,
        text="PV capacity factor - Hornsund",
        font=("TkDefaultFont", 11, "bold"),
    ).grid(
        row=0,
        column=0,
        columnspan=3,
        sticky="w",
    )

    ttk.Label(
        outer,
        text=(
            "Select the year to analyse and, if needed, modify the PV-model "
            "parameters. The proposed values are the current script defaults."
        ),
        justify="left",
        wraplength=680,
    ).grid(
        row=1,
        column=0,
        columnspan=3,
        sticky="w",
        pady=(4, 12),
    )

    # ------------------------------------------------------------------
    # YEAR
    # ------------------------------------------------------------------
    ttk.Label(
        outer,
        text="Year to analyse",
    ).grid(
        row=2,
        column=0,
        sticky="w",
        pady=(3, 10),
    )

    year_labels = [
        f"{year} ({year_counts.get(year, 0)} source rows)"
        for year in candidate_years
    ]

    default_index = candidate_years.index(default_year)
    year_var = tk.StringVar(value=year_labels[default_index])

    year_combo = ttk.Combobox(
        outer,
        textvariable=year_var,
        values=year_labels,
        state="readonly",
        width=38,
    )
    year_combo.grid(
        row=2,
        column=1,
        columnspan=2,
        sticky="ew",
        padx=(12, 8),
        pady=(3, 10),
    )

    ttk.Separator(
        outer,
        orient="horizontal",
    ).grid(
        row=3,
        column=0,
        columnspan=3,
        sticky="ew",
        pady=(2, 10),
    )

    # ------------------------------------------------------------------
    # NUMERIC PARAMETERS
    # ------------------------------------------------------------------
    fields = [
        ("Surface tilt", "surface_tilt", SURFACE_TILT, "deg"),
        ("Surface azimuth", "surface_azimuth", SURFACE_AZIMUTH, "deg"),
        ("Minimum ground albedo", "albedo_min", ALBEDO_MIN, "-"),
        ("Maximum ground albedo", "albedo_max", ALBEDO_MAX, "-"),
        ("Derating factor", "derating_factor", DERATING_FACTOR, "-"),
        (
            "Minimum solar elevation",
            "min_solar_elevation",
            MIN_SOLAR_ELEVATION_DEG,
            "deg",
        ),
        ("NOCT", "noct", NOCT, "°C"),
        (
            "Temperature coefficient γ",
            "temperature_coefficient",
            TEMPERATURE_COEFFICIENT,
            "1/°C",
        ),
        (
            "Reference cell temperature",
            "reference_cell_temperature",
            REFERENCE_CELL_TEMPERATURE,
            "°C",
        ),
        (
            "NOCT reference ambient temperature",
            "noct_reference_ambient_temperature",
            NOCT_REFERENCE_AMBIENT_TEMPERATURE,
            "°C",
        ),
        (
            "NOCT reference irradiance",
            "noct_reference_irradiance",
            NOCT_REFERENCE_IRRADIANCE,
            "W/m²",
        ),
        (
            "Temperature file UTC offset",
            "temperature_time_offset_hours",
            TEMPERATURE_TIME_OFFSET_HOURS,
            "h",
        ),
    ]

    variables = {}
    first_field_row = 4

    for row_index, (label, key, default, unit) in enumerate(
        fields,
        start=first_field_row,
    ):
        ttk.Label(
            outer,
            text=label,
        ).grid(
            row=row_index,
            column=0,
            sticky="w",
            pady=3,
        )

        variable = tk.StringVar(value=str(default))
        variables[key] = variable

        ttk.Entry(
            outer,
            textvariable=variable,
            width=24,
        ).grid(
            row=row_index,
            column=1,
            sticky="ew",
            padx=(12, 8),
            pady=3,
        )

        ttk.Label(
            outer,
            text=unit,
            width=7,
        ).grid(
            row=row_index,
            column=2,
            sticky="w",
            pady=3,
        )

    options_row = first_field_row + len(fields)

    ttk.Separator(
        outer,
        orient="horizontal",
    ).grid(
        row=options_row,
        column=0,
        columnspan=3,
        sticky="ew",
        pady=(12, 10),
    )

    # ------------------------------------------------------------------
    # OPTIONS
    # ------------------------------------------------------------------
    ttk.Label(
        outer,
        text="Direct source column",
    ).grid(
        row=options_row + 1,
        column=0,
        sticky="w",
        pady=3,
