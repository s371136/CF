            float(subset["capacity_factor_kW_per_kWp"].mean()),
            float(subset["capacity_factor_kW_per_kWp"].max()),
            float(subset["poa_global_Wm2"].mean()),
        ]
        for column, value in enumerate(values, start=1):
            summary.cell(row, column, value)
        summary.cell(row, 3).number_format = "#,##0.0"
        for column in (4, 5):
            summary.cell(row, column).number_format = "0.0000"
        summary.cell(row, 6).number_format = "0.0"

    for column, width in zip("ABCDEF", [12, 18, 31, 14, 14, 28]):
        summary.column_dimensions[column].width = width

    output_columns = [
        "timestamp_utc",
        "ghi_horizontal_Wm2",
        "dhi_horizontal_Wm2",
        "bhi_horizontal_Wm2",
        "derived_dni_Wm2",
        "solar_declination_deg",
        "hour_angle_deg",
        "solar_zenith_deg",
        "solar_elevation_deg",
        "solar_azimuth_deg",
        "incidence_angle_deg",
        "poa_direct_Wm2",
        "poa_diffuse_Wm2",
        "ground_albedo",
        "snow_cover_fraction_2015_reference",
        "poa_ground_reflected_Wm2",
        "poa_global_Wm2",
        "air_temperature_C",
        "cell_temperature_C",
        "temperature_factor",
        "capacity_factor_kW_per_kWp",
    ]

    pretty_headers = [
        "Date and time UTC",
        "GHI horizontal (W/m²)",
        "DHI horizontal (W/m²)",
        "BHI horizontal / source Direct (W/m²)",
        "Derived DNI (W/m²)",
        "Solar declination (°)",
        "Hour angle (°)",
        "Solar zenith (°)",
        "Solar elevation (°)",
        "Solar azimuth (°)",
        "PV incidence angle (°)",
        "POA direct (W/m²)",
        "POA diffuse (W/m²)",
        "Ground albedo rho(t) (-)",
        "Snow cover fraction - 2015 reference (-)",
        "POA ground reflected (W/m²)",
        "POA global (W/m²)",
        "Air temperature (°C)",
        "Cell temperature (°C)",
        "Temperature factor (-)",
        "Capacity factor (kW/kWp)",
    ]

    for year in years:
        subset = results[results["year"] == year][output_columns].copy()
