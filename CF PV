    drop_feb29_var = tk.BooleanVar(value=DROP_FEB29)
    ttk.Checkbutton(
        outer,
        text="Remove 29 February in leap years (2016: 8784 → 8760 h)",
        variable=drop_feb29_var,
    ).grid(
        row=options_row + 4,
        column=0,
        columnspan=3,
        sticky="w",
        pady=2,
    )

    interpolate_temp_var = tk.BooleanVar(
        value=INTERPOLATE_MISSING_TEMPERATURE
    )
    ttk.Checkbutton(
        outer,
        text=(
            "Interpolate missing air-temperature values "
            "(large gaps are reported as warnings)"
        ),
        variable=interpolate_temp_var,
    ).grid(
        row=options_row + 5,
        column=0,
        columnspan=3,
        sticky="w",
        pady=(2, 2),
    )

    ttk.Label(
        outer,
        text=(
            "Temperature correction: "
            "Tcell = Tair + (NOCT - Tair,NOCT) / G_NOCT × POA; "
            "fT = 1 + γ × (Tcell - Tref)."
        ),
        justify="left",
        wraplength=680,
    ).grid(
        row=options_row + 7,
        column=0,
        columnspan=3,
        sticky="w",
        pady=(8, 0),
    )

    def parse_float(key: str, label: str) -> float:
        raw = variables[key].get().strip().replace(",", ".")
        try:
            return float(raw)
        except ValueError as exc:
            raise ValueError(f"'{label}' must be a number.") from exc

    def accept():
        try:
            selected_year = int(year_var.get().split()[0])

            settings = {
                "surface_tilt": parse_float("surface_tilt", "Surface tilt"),
                "surface_azimuth": parse_float(
                    "surface_azimuth",
                    "Surface azimuth",
                ),
                "albedo_min": parse_float(
                    "albedo_min",
                    "Minimum ground albedo",
                ),
                "albedo_max": parse_float(
                    "albedo_max",
                    "Maximum ground albedo",
                ),
                "derating_factor": parse_float(
                    "derating_factor",
                    "Derating factor",
                ),
                "min_solar_elevation": parse_float(
                    "min_solar_elevation",
                    "Minimum solar elevation",
                ),
                "direct_input_type": direct_var.get(),
                "hourly_conversion": conversion_var.get(),
                "clip_at_rated_power": bool(clip_var.get()),
                "drop_feb29": bool(drop_feb29_var.get()),
                "noct": parse_float("noct", "NOCT"),
                "temperature_coefficient": parse_float(
                    "temperature_coefficient",
                    "Temperature coefficient",
                ),
                "reference_cell_temperature": parse_float(
                    "reference_cell_temperature",
                    "Reference cell temperature",
                ),
                "noct_reference_ambient_temperature": parse_float(
                    "noct_reference_ambient_temperature",
                    "NOCT reference ambient temperature",
                ),
                "noct_reference_irradiance": parse_float(
                    "noct_reference_irradiance",
                    "NOCT reference irradiance",
                ),
                "temperature_time_offset_hours": parse_float(
                    "temperature_time_offset_hours",
                    "Temperature file UTC offset",
                ),
                "interpolate_missing_temperature": bool(
                    interpolate_temp_var.get()
                ),
            }

            if not 0.0 <= settings["surface_tilt"] <= 90.0:
                raise ValueError("Surface tilt must be between 0 and 90 deg.")

            if not -180.0 <= settings["surface_azimuth"] <= 180.0:
                raise ValueError("Surface azimuth must be between -180 and +180 deg.")

            if not 0.0 <= settings["albedo_min"] <= 1.0:
                raise ValueError("Minimum ground albedo must be between 0 and 1.")
            if not 0.0 <= settings["albedo_max"] <= 1.0:
                raise ValueError("Maximum ground albedo must be between 0 and 1.")
            if settings["albedo_min"] > settings["albedo_max"]:
                raise ValueError("Minimum ground albedo cannot exceed maximum ground albedo.")

            if not 0.0 < settings["derating_factor"] <= 1.0:
                raise ValueError("Derating factor must be > 0 and <= 1.")

            if not 0.0 <= settings["min_solar_elevation"] < 90.0:
                raise ValueError(
                    "Minimum solar elevation must be between 0 and 90 deg."
                )

            if settings["noct_reference_irradiance"] <= 0.0:
                raise ValueError("NOCT reference irradiance must be positive.")

            if settings["noct"] <= -100.0 or settings["noct"] >= 150.0:
                raise ValueError("NOCT value is outside a reasonable range.")

            if settings["temperature_coefficient"] >= 0.0:
                raise ValueError(
                    "Temperature coefficient γ is normally negative for PV modules."
                )

        except (ValueError, IndexError) as exc:
            messagebox.showerror(
                "Invalid settings",
                str(exc),
                parent=dialog,
            )
            return

        result["year"] = selected_year
        result["settings"] = settings
        dialog.destroy()

    def cancel():
        dialog.destroy()

    button_frame = ttk.Frame(outer)
    button_frame.grid(
        row=options_row + 8,
        column=0,
        columnspan=3,
        pady=(14, 0),
        sticky="e",
    )

    ttk.Button(
        button_frame,
        text="Cancel",
        command=cancel,
    ).pack(side="right", padx=(8, 0))

    ttk.Button(
        button_frame,
        text="Run analysis",
        command=accept,
    ).pack(side="right")

    dialog.protocol("WM_DELETE_WINDOW", cancel)
    dialog.bind("<Escape>", lambda _event: cancel())

    dialog.update_idletasks()
    x = (dialog.winfo_screenwidth() - dialog.winfo_reqwidth()) // 2
    y = (dialog.winfo_screenheight() - dialog.winfo_reqheight()) // 2
    dialog.geometry(f"+{x}+{y}")

    dialog.lift()
    dialog.focus_force()
    year_combo.focus_set()
    dialog.mainloop()

    if result["year"] is None or result["settings"] is None:
        raise SystemExit("Analysis cancelled.")

    return int(result["year"]), dict(result["settings"])


