        row=options_row + 1,
        column=1,
        sticky="ew",
        padx=(12, 8),
        pady=3,
    )

    ttk.Label(
        outer,
        text="3-hourly → hourly",
    ).grid(
        row=options_row + 2,
        column=0,
        sticky="w",
        pady=3,
    )

    conversion_var = tk.StringVar(value=HOURLY_CONVERSION)
    conversion_combo = ttk.Combobox(
