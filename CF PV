            sheet.column_dimensions[letter].width = 22

        for row in range(2, sheet.max_row + 1):
            sheet.cell(row, 1).number_format = "yyyy-mm-dd hh:mm"
            for column in range(2, len(output_columns)):
                sheet.cell(row, column).number_format = "0.00"
            sheet.cell(row, len(output_columns)).number_format = "0.0000"

    workbook.properties.title = "Hornsund hourly photovoltaic capacity factor"
    workbook.properties.subject = "PV transposition from horizontal GHI/DHI/BHI data"
    workbook.save(path)


def plot_capacity_factor(results: pd.DataFrame) -> None:
    for year in sorted(results["year"].unique()):
        subset = results[results["year"] == year]
        figure, axis = plt.subplots(figsize=(13, 5))
        axis.plot(
            subset["timestamp_utc"],
            subset["capacity_factor_kW_per_kWp"],
            linewidth=0.8,
        )
        axis.set_title(f"Hourly photovoltaic capacity factor - {int(year)}")
        axis.set_xlabel("Month")
        axis.set_ylabel("Capacity factor [kW/kWp]")
        axis.set_ylim(bottom=0.0)
        axis.xaxis.set_major_locator(mdates.MonthLocator())
        axis.xaxis.set_major_formatter(mdates.DateFormatter("%b"))
        axis.grid(True, linewidth=0.6)
        figure.tight_layout()
        plt.show()


def print_summary(results: pd.DataFrame) -> None:
    print("\nRESULTS")
    print("-------")
    for year in sorted(results["year"].unique()):
        subset = results[results["year"] == year]
        specific_yield = subset["capacity_factor_kW_per_kWp"].sum()
        mean_cf = subset["capacity_factor_kW_per_kWp"].mean()
        print(
            f"{int(year)}: {len(subset)} h | "
            f"specific production = {specific_yield:.1f} kWh/kWp | "
            f"mean CF = {mean_cf:.4f}"
        )

    high_dni = (results["derived_dni_Wm2"] > 1400.0).sum()
    if high_dni:
        print(
            f"WARNING: {high_dni} hourly points have derived DNI > 1400 W/m2. "
            "This usually occurs close to the horizon and should be checked."
        )


def main(show_plot: bool = True) -> None:
    print("=" * 78, flush=True)
    print("HORNSUND PV CAPACITY FACTOR - WITH SEKLIMA TEMPERATURE", flush=True)
    print("=" * 78, flush=True)

    print("1. Select the Hornsund irradiation CSV...", flush=True)
    input_path = choose_input_file()
    site, source_3h = read_hornsund_csv(input_path)

    print(f"3-hourly irradiation source records: {len(source_3h)}", flush=True)

    print("2. Select the SEKLIMA file containing air temperature...", flush=True)
    temperature_path = choose_temperature_file()

    # Read once with the default +1 h offset. The chosen offset is applied again
    # after the GUI in case the user changes it.
    temperature_data = read_temperature_csv(temperature_path)

    solar_years = sorted(
        source_3h["timestamp"]
        .dt.year
        .dropna()
        .astype(int)
        .unique()
        .tolist()
    )

    temperature_years = sorted(
        temperature_data["timestamp_utc"]
        .dt.year
        .dropna()
        .astype(int)
        .unique()
        .tolist()
    )

    candidate_years = sorted(
        set(solar_years) & set(temperature_years)
    )

    if not candidate_years:
        raise ValueError(
            "No common year between irradiation and temperature files.\n"
            f"Irradiation years: {solar_years}\n"
            f"Temperature years: {temperature_years}"
        )

    year_counts = {
        year: int((source_3h["timestamp"].dt.year == year).sum())
        for year in candidate_years
    }

    print(f"Common available years: {candidate_years}", flush=True)

    # One GUI: year + PV geometry + temperature-model parameters.
    year, settings = ask_analysis_setup(
        candidate_years,
        year_counts,
    )

    apply_analysis_settings(settings)

    # Re-read temperature after the user-selected time offset is applied.
    temperature_data = read_temperature_csv(temperature_path)

    print("\nSELECTED ANALYSIS", flush=True)
    print("-----------------", flush=True)
    print(f"Year: {year}", flush=True)
    print(f"Surface tilt: {SURFACE_TILT:.2f} deg", flush=True)
    print(f"Surface azimuth: {SURFACE_AZIMUTH:.2f} deg", flush=True)
    print(f"Minimum ground albedo: {ALBEDO_MIN:.3f}", flush=True)
    print(f"Maximum ground albedo: {ALBEDO_MAX:.3f}", flush=True)
    print(
    "Albedo model: dynamic rho(t) based on 2015 Hornsund/Fuglebekken snow-cover observations (17 May -> 06 July)",
    flush=True,
)
    print(f"Derating factor: {DERATING_FACTOR:.3f}", flush=True)
    print(f"Minimum solar elevation: {MIN_SOLAR_ELEVATION_DEG:.2f} deg", flush=True)
    print(f"Direct input type: {DIRECT_INPUT_TYPE}", flush=True)
    print(f"Hourly conversion: {HOURLY_CONVERSION}", flush=True)
    print(f"Clip at rated power: {CLIP_AT_RATED_POWER}", flush=True)
    print(f"Drop 29 February: {DROP_FEB29}", flush=True)
    print(f"NOCT: {NOCT:.2f} °C", flush=True)
    print(
        f"Temperature coefficient: {TEMPERATURE_COEFFICIENT:.6f} 1/°C",
        flush=True,
    )
    print(
        f"Reference cell temperature: {REFERENCE_CELL_TEMPERATURE:.2f} °C",
        flush=True,
    )
    print(
        "NOCT reference conditions: "
        f"{NOCT_REFERENCE_AMBIENT_TEMPERATURE:.2f} °C, "
        f"{NOCT_REFERENCE_IRRADIANCE:.1f} W/m²",
        flush=True,
    )
    print(
        f"Temperature file UTC offset: +{TEMPERATURE_TIME_OFFSET_HOURS:g} h",
        flush=True,
    )
    print(
        f"Interpolate missing temperature: "
        f"{INTERPOLATE_MISSING_TEMPERATURE}",
        flush=True,
    )

    source_year = source_3h[
        source_3h["timestamp"].dt.year == year
    ].copy()

    if source_year.empty:
        raise ValueError(f"No irradiation data found for {year}.")

    print(
        f"3-hourly irradiation records used for {year}: {len(source_year)}",
        flush=True,
    )

    hourly = to_hourly(source_year)

    expected_hours = (
        8760
        if (DROP_FEB29 and pd.Timestamp(f"{year}-01-01").is_leap_year)
        else (8784 if pd.Timestamp(f"{year}-01-01").is_leap_year else 8760)
    )

    print(
        f"Hourly irradiation records after conversion: {len(hourly)} "
        f"(expected {expected_hours})",
        flush=True,
    )

    hourly, temperature_quality = attach_temperature(
        hourly,
        temperature_data,
        year,
    )

    results = calculate_pv(hourly, site)
    print_summary(results)

    print("\nALBEDO PROFILE USED", flush=True)
    print("-------------------", flush=True)
    monthly_used = (
        results.assign(month=results["timestamp_utc"].dt.month)
        .groupby("month")["ground_albedo"]
        .agg(["min", "mean", "max"])
    )
    for month, row in monthly_used.iterrows():
        print(
            f"Month {int(month):02d}: min={row['min']:.3f}, "
            f"mean={row['mean']:.3f}, max={row['max']:.3f}",
            flush=True,
        )

    print("\nTEMPERATURE DATA QUALITY", flush=True)
    print("------------------------", flush=True)
    print(
        "Missing before fill: "
        f"{temperature_quality['temperature_missing_before_fill']} h",
        flush=True,
    )
    print(
        "Longest missing gap: "
        f"{temperature_quality['temperature_longest_missing_gap_h']} h",
        flush=True,
    )
    print(
        "Interpolation used: "
        f"{temperature_quality['temperature_interpolation_used']}",
        flush=True,
    )

    default_name = f"PV_capacity_factor_Hornsund_{year}_with_temperature.xlsx"
    output_path = choose_output_file(default_name)

    write_results(output_path, results, site)

    print(f"\nCreated: {output_path}", flush=True)

    if messagebox is not None:
        root = tk.Tk()
        root.withdraw()
        try:
            root.attributes("-topmost", True)
        except Exception:
            pass

        messagebox.showinfo(
            "PV capacity factor",
            (
                f"Calculation completed.\n\n"
                f"Year: {year}\n"
                f"Processed hours: {len(results)}\n"
                f"Mean air temperature: "
                f"{results['air_temperature_C'].mean():.2f} °C\n"
                f"Mean cell temperature: "
                f"{results['cell_temperature_C'].mean():.2f} °C\n"
                f"Mean CF: "
                f"{results['capacity_factor_kW_per_kWp'].mean():.4f}\n\n"
                f"Saved file:\n{output_path}"
            ),
            parent=root,
        )
        root.destroy()

    if show_plot:
        plot_capacity_factor(results)


if __name__ == "__main__":
    main()
