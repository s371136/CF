# ============================ USER INPUTS ============================
# PV orientation. Azimuth convention:
#   0° = South, -90° = East, +90° = West, +/-180° = North.
SURFACE_TILT = 60.0          # [deg]
SURFACE_AZIMUTH = 0.0        # [deg]

# Ground reflection.
# The GUI asks only for the minimum and maximum physically meaningful albedo.
ALBEDO_MIN = 0.20   # [-] snow-free / dark ground
ALBEDO_MAX = 0.80   # [-] fully snow-covered ground

# Observed 2015 Hornsund/Fuglebekken snow-cover reference points.
# Values are Snow Cover Extent (SCE) fractions, not direct albedo measurements.
# The same 2015 month/day profile is used as the reference profile if another
# year is selected in the GUI.
SNOW_COVER_2015_POINTS = [
    ((5, 17), 0.90),
    ((6, 10), 0.75),
    ((6, 15), 0.50),
    ((6, 20), 0.25),
    ((6, 27), 0.10),
    ((7, 6),  0.02),
]

# Electrical losses not modelled separately.
DERATING_FACTOR = 0.82       # [-]
CLIP_AT_RATED_POWER = True

# Interpretation of the source Direct column.
# Current evidence (HOR filename and exact GHI = DHI + Direct closure) supports BHI.
# If the source documentation later confirms DNI, change this single line to "DNI".
DIRECT_INPUT_TYPE = "BHI"

# 3-hourly -> hourly conversion.
# "linear": linearly interpolate the values at the 3-hour timestamps.
# "repeat": repeat each 3-hour value for the next 3 one-hour steps.
# Use "repeat" instead if the source documentation confirms that values are
# 3-hour interval MEANS rather than values representative of the timestamp.
HOURLY_CONVERSION = "linear"

# Keep leap years as 8784 h by default. Set True only if a downstream model
# strictly requires 8760 h and you intentionally want to remove 29 February.
DROP_FEB29 = False

# Numerical protection close to sunrise/sunset. BHI/cos(theta_z) becomes unstable
# when the Sun is extremely close to the horizon.
MIN_SOLAR_ELEVATION_DEG = 3.0

# Temperature model. Air temperature is read from the separate SEKLIMA file.
USE_TEMPERATURE_CORRECTION = True
NOCT = 45.0                         # [°C]
TEMPERATURE_COEFFICIENT = -0.0035   # 1/°C   SunPower E20-327
REFERENCE_CELL_TEMPERATURE = 25.0  # [°C]
NOCT_REFERENCE_AMBIENT_TEMPERATURE = 20.0  # [°C]
NOCT_REFERENCE_IRRADIANCE = 800.0          # [W/m²]
TEMPERATURE_TIME_OFFSET_HOURS = 1.0        # Norwegian mean time = UTC+1
INTERPOLATE_MISSING_TEMPERATURE = True
# ===================================================================


