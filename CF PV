    global SURFACE_TILT
    global SURFACE_AZIMUTH
    global ALBEDO_MIN
    global ALBEDO_MAX
    global DERATING_FACTOR
    global CLIP_AT_RATED_POWER
    global DIRECT_INPUT_TYPE
    global HOURLY_CONVERSION
    global DROP_FEB29
    global MIN_SOLAR_ELEVATION_DEG
    global NOCT
    global TEMPERATURE_COEFFICIENT
    global REFERENCE_CELL_TEMPERATURE
    global NOCT_REFERENCE_AMBIENT_TEMPERATURE
    global NOCT_REFERENCE_IRRADIANCE
    global TEMPERATURE_TIME_OFFSET_HOURS
    global INTERPOLATE_MISSING_TEMPERATURE

    SURFACE_TILT = float(settings["surface_tilt"])
    SURFACE_AZIMUTH = float(settings["surface_azimuth"])
