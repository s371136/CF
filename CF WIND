def full_hourly_index(year: int) -> pd.DatetimeIndex:
    return pd.date_range(
        start=f"{year}-01-01 00:00:00",
        end=f"{year}-12-31 23:00:00",
        freq="h",
    )


def get_year_information(
    data: pd.DataFrame,
) -> tuple[list[int], dict[int, int], dict[int, int]]:
    available_years = sorted(
        data["timestamp"].dt.year.dropna().unique().astype(int)
    )

    if not available_years:
        raise ValueError(
            "Non è stato possibile identificare nessun anno."
        )

    year_counts: dict[int, int] = {}
    missing_years: dict[int, int] = {}

    for year in available_years:
        year_counts[year] = int(
            (data["timestamp"].dt.year == year).sum()
        )

        expected_index = full_hourly_index(year)

        year_timestamps = data.loc[
            data["timestamp"].dt.year == year,
            "timestamp",
        ]

        valid_timestamps = year_timestamps[
            year_timestamps.isin(expected_index)
        ]

        unique_valid_timestamps = valid_timestamps.unique()

        missing_years[year] = int(
            len(expected_index) - len(unique_valid_timestamps)
        )

    print(
        "Righe disponibili per anno:",
        year_counts,
        flush=True,
    )

    print(
        "Ore mancanti per anno:",
        missing_years,
        flush=True,
    )

    return available_years, year_counts, missing_years


def longest_missing_run(series: pd.Series) -> int:
    missing = series.isna().to_numpy()

    if not missing.any():
        return 0

    padded = np.concatenate(
        ([False], missing, [False])
    )

    changes = np.flatnonzero(
        padded[1:] != padded[:-1]
    )

    lengths = changes[1::2] - changes[::2]

    return int(lengths.max()) if len(lengths) else 0


def create_complete_year_profile(
    data: pd.DataFrame,
    year: int,
    interpolate_missing: bool,
) -> tuple[pd.Series, dict]:
    year_data = data[
        data["timestamp"].dt.year == year
    ].copy()

    if year_data.empty:
        raise ValueError(
            f"Nessun dato trovato per il {year}."
        )

    source = (
        year_data
        .set_index("timestamp")["wind_speed"]
        .sort_index()
    )

    index = full_hourly_index(year)

    profile = source.reindex(index)

    negative_count = int(
        (profile < 0).sum()
    )

    profile = profile.mask(profile < 0)

    missing_before = int(
        profile.isna().sum()
    )

    max_gap = longest_missing_run(profile)

    quality = {
        "year": year,
        "expected_hours": len(index),
        "source_rows_for_year": len(year_data),
        "source_valid_wind_values": int(source.notna().sum()),
        "negative_values_rejected": negative_count,
        "missing_values_before_fill": missing_before,
        "longest_missing_run_hours": max_gap,
        "interpolation_used": False,
    }

    print(
        f"Anno {year}: {missing_before} ore mancanti.",
        flush=True,
    )

    if missing_before > 0:
        if not interpolate_missing:
            raise ValueError(
                f"Il profilo contiene {missing_before} ore mancanti. "
                "Seleziona l'interpolazione per continuare."
            )

        print(
            "Interpolazione lineare dei valori mancanti...",
            flush=True,
        )

        profile = profile.interpolate(
            method="time",
            limit_direction="both",
        )

        quality["interpolation_used"] = True

    if profile.isna().any():
        raise ValueError(
            "Restano valori mancanti dopo l'interpolazione."
        )

    return profile.astype(float), quality


# =============================================================================
# WIND MODEL
# =============================================================================

def calculate_profile(
    reference_profile: pd.Series,
    params: TurbineParameters,
) -> pd.DataFrame:
    print(
        "Calcolo del profilo di potenza...",
        flush=True,
    )

    reference_speed = reference_profile.to_numpy(
        dtype=float
    )

    height_factor = (
        params.turbine_height_m
        / params.reference_height_m
    ) ** params.power_law_exponent

    turbine_speed = reference_speed * height_factor

    capacity_factor = np.zeros_like(
        turbine_speed,
        dtype=float,
    )

    cubic_region = (
        (turbine_speed >= params.cut_in_speed)
        & (turbine_speed < params.rated_speed)
    )

    denominator = (
        params.rated_speed ** 3
        - params.cut_in_speed ** 3
    )

    capacity_factor[cubic_region] = (
        turbine_speed[cubic_region] ** 3
        - params.cut_in_speed ** 3
    ) / denominator

    rated_region = (
        (turbine_speed >= params.rated_speed)
        & (turbine_speed < params.cut_out_speed)
    )

    capacity_factor[rated_region] = 1.0

    above_cutout = (
        turbine_speed >= params.cut_out_speed
    )

    capacity_factor[above_cutout] = 0.0

    capacity_factor = np.clip(
        capacity_factor,
        0.0,
        1.0,
    )

    power_kw = (
        capacity_factor
        * params.rated_power_kw
    )

    return pd.DataFrame(
        {
            "timestamp": reference_profile.index,
            "reference_wind_speed": reference_speed,
            "turbine_wind_speed": turbine_speed,
            "capacity_factor": capacity_factor,
            "turbine_power_kw": power_kw,
        }
    )


