def validate_turbine_parameters(params: TurbineParameters) -> None:
    if params.rated_power_kw <= 0:
        raise ValueError("La potenza nominale deve essere positiva.")

    if params.peak_power_kw <= 0:
        raise ValueError("La potenza di picco deve essere positiva.")

    if params.reference_height_m <= 0:
        raise ValueError("L'altezza di riferimento deve essere positiva.")

    if params.turbine_height_m <= 0:
        raise ValueError("L'altezza della turbina deve essere positiva.")

    if params.power_law_exponent < 0:
        raise ValueError(
            "L'esponente della power law non può essere negativo."
        )

    if not (
        0
        <= params.cut_in_speed
        < params.rated_speed
        < params.cut_out_speed
    ):
        raise ValueError(
            "Deve valere: 0 ≤ cut-in < velocità nominale < cut-out."
        )

    if params.survival_speed < params.cut_out_speed:
        raise ValueError(
            "La velocità di sopravvivenza non può essere inferiore al cut-out."
        )


