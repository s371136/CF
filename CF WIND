def _detect_csv_separator(path: Path) -> str:
    with path.open(
        "r",
        encoding="utf-8-sig",
        errors="replace",
        newline="",
    ) as handle:
        sample = handle.read(32_768)

    try:
        dialect = csv.Sniffer().sniff(
            sample,
            delimiters=",;\t|",
        )
        return dialect.delimiter
    except csv.Error:
        return ";"


def _normalize_column_names(df: pd.DataFrame) -> pd.DataFrame:
    df = df.copy()

    df.columns = (
        df.columns
        .astype(str)
        .str.replace("\ufeff", "", regex=False)
        .str.strip()
    )

    return df


def read_input_table(path: Path) -> pd.DataFrame:
    suffix = path.suffix.lower()

    if suffix == ".csv":
        separator = _detect_csv_separator(path)

        print(
            f"Separatore CSV rilevato: {separator!r}",
            flush=True,
        )

        try:
            df = pd.read_csv(
                path,
                sep=separator,
                engine="c",
                low_memory=False,
            )
        except Exception:
            df = pd.read_csv(
                path,
                sep=separator,
                engine="python",
                low_memory=False,
            )

    elif suffix == ".xlsx":
        df = pd.read_excel(
            path,
            sheet_name=0,
        )

    elif suffix == ".xls":
        try:
            df = pd.read_excel(
                path,
                sheet_name=0,
            )
        except ImportError as exc:
            raise RuntimeError(
                "Per leggere file .xls è necessario installare xlrd:\n"
                "pip install xlrd"
            ) from exc

    else:
        raise ValueError(
            f"Tipo di file non supportato: '{suffix}'. "
            "Usa CSV, XLSX o XLS."
        )

    df = _normalize_column_names(df)

    print(
        f"Tabella letta: {df.shape[0]} righe, "
        f"{df.shape[1]} colonne.",
        flush=True,
    )

    print(
        "Colonne trovate:",
        list(df.columns),
        flush=True,
    )

    if df.empty:
        raise ValueError("Il file è vuoto.")

    return df


def choose_column(
    df: pd.DataFrame,
    default_name: str,
    description: str,
) -> str:
    if default_name in df.columns:
        return default_name

    columns = [str(column) for column in df.columns]

    if not columns:
        raise ValueError(
            "Il file non contiene colonne leggibili."
        )

    return choose_from_list_dialog(
        title="Selezione colonna",
        message=(
            f"La colonna predefinita '{default_name}' "
            "non è stata trovata.\n"
            f"Seleziona la colonna per {description}."
        ),
        values=columns,
        default=columns[0],
    )


def parse_datetime_column(series: pd.Series) -> pd.Series:
    raw = series.astype(str).str.strip()

    parsed = pd.to_datetime(
        raw,
        format="%d.%m.%Y %H:%M",
        errors="coerce",
    )

    missing = parsed.isna() & raw.ne("")

    if missing.any():
        parsed.loc[missing] = pd.to_datetime(
            raw.loc[missing],
            dayfirst=True,
            errors="coerce",
        )

    missing = parsed.isna() & raw.ne("")

    if missing.any():
        parsed.loc[missing] = pd.to_datetime(
            raw.loc[missing],
            errors="coerce",
        )

    return parsed


def prepare_source_data(
    path: Path,
) -> tuple[pd.DataFrame, str, str]:
    print("Lettura del file meteorologico...", flush=True)

    df = read_input_table(path)

    time_column = choose_column(
        df,
        DEFAULT_TIME_COLUMN,
        "la data e l'ora",
    )

    wind_column = choose_column(
        df,
        DEFAULT_WIND_COLUMN,
        "la velocità del vento",
    )

    data = df[[time_column, wind_column]].copy()

    print(
        f"Colonna temporale selezionata: {time_column}",
        flush=True,
    )

    print(
        f"Colonna vento selezionata: {wind_column}",
        flush=True,
    )

    print(
        "Conversione delle date...",
        flush=True,
    )

    data["timestamp"] = parse_datetime_column(
        data[time_column]
    )

    data["wind_speed"] = (
        data[wind_column]
        .astype(str)
        .str.strip()
        .str.replace(",", ".", regex=False)
        .str.replace(";", ".", regex=False)
    )

    data["wind_speed"] = pd.to_numeric(
        data["wind_speed"],
        errors="coerce",
    )

    invalid_time_rows = int(
        data["timestamp"].isna().sum()
    )

    invalid_wind_rows = int(
        data["wind_speed"].isna().sum()
    )

    print(
        f"Date non valide: {invalid_time_rows}",
        flush=True,
    )

    print(
        f"Velocità non valide: {invalid_wind_rows}",
        flush=True,
    )

    data = data.dropna(
        subset=["timestamp"]
    ).copy()

    data["timestamp"] = data["timestamp"].dt.floor("h")

    data.loc[
        data["wind_speed"] < 0,
        "wind_speed",
    ] = np.nan

    print(
        "Aggregazione dei dati alla frequenza oraria...",
        flush=True,
    )

    data = (
        data.groupby(
            "timestamp",
            as_index=False,
        )["wind_speed"]
        .mean()
        .sort_values("timestamp")
        .reset_index(drop=True)
    )

    if data.empty:
        raise ValueError(
            "Dopo la conversione non sono rimasti dati validi."
        )

    print(
        f"Dati orari disponibili: {len(data)} righe.",
        flush=True,
    )

    print(
        f"Intervallo temporale: "
        f"{data['timestamp'].min()} - "
        f"{data['timestamp'].max()}",
        flush=True,
    )

    return data, time_column, wind_column


