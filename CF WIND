def _new_hidden_root():
    import tkinter as tk

    root = tk.Tk()
    root.withdraw()

    try:
        root.attributes("-topmost", True)
    except Exception:
        pass

    return root


def select_input_file() -> Path:
    from tkinter import filedialog

    root = _new_hidden_root()

    try:
        selected = filedialog.askopenfilename(
            parent=root,
            title="Seleziona il file meteorologico",
            filetypes=[
                ("File meteorologici", "*.csv *.xlsx *.xls"),
                ("CSV", "*.csv"),
                ("Excel", "*.xlsx *.xls"),
                ("Tutti i file", "*.*"),
            ],
        )
    finally:
        root.destroy()

    if not selected:
        raise SystemExit("Selezione file annullata.")

    return Path(selected)


def select_output_file(default_directory: Path, default_filename: str) -> Path:
    from tkinter import filedialog

    root = _new_hidden_root()

    try:
        selected = filedialog.asksaveasfilename(
            parent=root,
            title="Salva i risultati",
            initialdir=str(default_directory),
            initialfile=default_filename,
            defaultextension=".xlsx",
            filetypes=[
                ("File Excel", "*.xlsx"),
                ("Tutti i file", "*.*"),
            ],
        )
    finally:
        root.destroy()

    if not selected:
        raise SystemExit("Salvataggio annullato.")

    path = Path(selected)

    if path.suffix.lower() != ".xlsx":
        path = path.with_suffix(".xlsx")

    return path


