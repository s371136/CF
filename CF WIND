def plot_capacity_factor(
    result_df: pd.DataFrame,
    params: TurbineParameters,
    year: int,
) -> None:
    figure, axis = plt.subplots(
        figsize=(13, 5)
    )

    axis.plot(
        result_df["timestamp"],
        result_df["capacity_factor"],
        linewidth=0.7,
    )

    axis.set_title(
        f"Hourly wind turbine capacity factor - "
        f"{params.name} - {year}"
    )

    axis.set_xlabel("Month")
    axis.set_ylabel("Capacity factor [-]")
    axis.set_ylim(0.0, 1.05)

    axis.xaxis.set_major_locator(
        mdates.MonthLocator()
    )

    axis.xaxis.set_major_formatter(
        mdates.DateFormatter("%b")
    )

    axis.grid(
        True,
        linewidth=0.6,
    )

    figure.tight_layout()
    plt.show()


